---
import Sparkline from './Sparkline.astro';
import { int, pos, pct, delta } from '../lib/format';
import type { KeywordStat } from '../lib/data';
interface Props {
  rows: KeywordStat[];
  filterable?: boolean;
}
const { rows, filterable = false } = Astro.props;
---
<div class="table-wrap">
  <table class:list={['kw', { filterable }]}>
    <thead>
      <tr>
        <th class="q">Requête</th>
        <th class="num" title="Position moyenne sur 7 jours">Pos. 7 j</th>
        <th class="num" title="Variation par rapport aux 7 jours précédents">Évol.</th>
        <th class="num hide-sm" title="Position moyenne sur 28 jours">Pos. 28 j</th>
        <th class="num">Clics</th>
        <th class="num hide-sm">Impr.</th>
        <th class="num hide-sm">CTR</th>
        <th class="hide-sm">90 jours</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => {
        const d = delta(r.delta7);
        return (
          <tr data-q={r.keyword.toLowerCase()}>
            <td class="q">
              {r.keyword}
              {r.impressions28 === 0 && <span class="badge muted">pas visible</span>}
            </td>
            <td class="num strong">{pos(r.pos7)}</td>
            <td class:list={['num', d.cls]}>{d.text}</td>
            <td class="num hide-sm">{pos(r.pos28)}</td>
            <td class="num">{int(r.clicks28)}</td>
            <td class="num hide-sm">{int(r.impressions28)}</td>
            <td class="num hide-sm">{pct(r.ctr28)}</td>
            <td class="hide-sm spark-cell"><Sparkline values={r.series} invert label={`Position de « ${r.keyword} » sur 90 jours`} /></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
