---
import '../styles/global.css';
import { meta, hasGsc, lastDay } from '../lib/data';
import { day } from '../lib/format';
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: "/", label: "Accueil" },
  { href: '/positions', label: 'Positions' },
  { href: '/concurrents', label: 'Concurrents' },
  { href: '/idees', label: 'Idées' },
];
const errors = Object.entries(meta.steps).filter(([, s]) => s.status === 'error');
const gscSkipped = meta.steps.gsc?.status === 'skipped';
const lastRun = meta.lastRun ? new Date(meta.lastRun).toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Paris' }) : null;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1f4d3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · SEO Esprit Aloé</title>
  </head>
  <body>
    <header class="top">
      <div class="brand">
        <span class="logo" aria-hidden="true">🌿</span>
        <div>
          <strong>SEO Esprit Aloé</strong>
          <span class="small">
            {lastRun ? `Collecte : ${lastRun}` : 'Aucune collecte pour l’instant'}
            {lastDay && ` · Search Console jusqu’au ${day(lastDay)}`}
          </span>
        </div>
      </div>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main>
      {errors.length > 0 && (
        <div class="alert">
          <strong>La dernière collecte a rencontré {errors.length > 1 ? `${errors.length} problèmes` : 'un problème'} :</strong>
          <ul>
            {errors.map(([name, s]) => (
              <li><code>{name}</code> : {s.message}{s.lastOk && ` (dernière réussite : ${day(s.lastOk)})`}</li>
            ))}
          </ul>
        </div>
      )}
      {!hasGsc && (
        <div class="alert info">
          {gscSkipped
            ? 'La Search Console n’est pas encore connectée : ajoute les 3 secrets Google dans GitHub (voir le README). Les pages Concurrents et Idées fonctionnent déjà.'
            : 'Pas encore de données Search Console : la première collecte n’a pas eu lieu.'}
        </div>
      )}
      <h1>{title}</h1>
      <slot />
    </main>
    <script>
      // Filtre des tableaux (seul JavaScript du site)
      document.querySelectorAll<HTMLInputElement>('input[data-filter]').forEach((input) => {
        const target = document.querySelector(input.dataset.filter!);
        input.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          target?.querySelectorAll<HTMLElement>('[data-q]').forEach((el) => {
            el.hidden = !!q && !el.dataset.q!.includes(q);
          });
        });
      });
    </script>
  </body>
</html>
